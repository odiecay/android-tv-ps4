@@ -167,26 +175,9 @@ static irqreturn_t icc_interrupt(int irq, void *arg)
 	return ret;
 }
 
-/* Handles a pending ICC event when its interrupt did not arrive. The
- * interrupt is held off meanwhile so the handler never runs twice. */
-static void icc_poll(struct bpcie_dev *sc)
-{
-	unsigned int irq = bpcie_irqnum(sc, BPCIE_SUBFUNC_ICC);
-
-	if (!(ioread32(sc->bar2 + BPCIE_REG_ICC_STATUS) &
-	      (BPCIE_ICC_SEND | BPCIE_ICC_ACK)))
-		return;
-	disable_irq(irq);
-	if (icc_interrupt(irq, sc) == IRQ_HANDLED)
-		dev_warn_once(&sc->pdev->dev,
-			      "icc: event found by polling; its interrupt was not delivered\n");
-	enable_irq(irq);
-}
-
 static int _bpcie_icc_cmd(struct bpcie_dev *sc, u8 major, u16 minor, const void *data,
 		    u16 length, void *reply, u16 reply_length, bool intr)
 {
-	unsigned long deadline;
 	int ret;
 	u32 req_empty, req_full;
 	u16 rep_checksum;
@@ -231,29 +222,35 @@ static int _bpcie_icc_cmd(struct bpcie_dev *sc, u8 major, u16 minor, const void
 	sc->icc.reply_pending = true;
 	spin_unlock_irq(&sc->icc.reply_lock);
 
+	/* v19: clear any stale STATUS bits left over from a missed IRQ on a
+	 * previous command, otherwise the southbridge may not raise a fresh
+	 * IRQ for this request. */
+	iowrite32(BPCIE_ICC_SEND | BPCIE_ICC_ACK,
+		  sc->bar2 + BPCIE_REG_ICC_STATUS);
+
 	iowrite32(BPCIE_ICC_SEND, sc->bar2 + BPCIE_REG_ICC_DOORBELL);
 
-	/* Wait for the reply interrupt in short slices and check the status
-	 * register in between. On the 6.15 Baikal kernel the southbridge set
-	 * the reply but the interrupt never arrived, and polling was the only
-	 * way ICC worked; without ICC the HDMI bridge can't be programmed. */
-	deadline = jiffies + HZ * ICC_TIMEOUT;
-	for (;;) {
-		if (intr)
-			ret = wait_event_interruptible_timeout(sc->icc.wq,
-					!sc->icc.reply_pending, msecs_to_jiffies(10));
-		else
-			ret = wait_event_timeout(sc->icc.wq,
-					!sc->icc.reply_pending, msecs_to_jiffies(10));
-		if (ret)
-			break;
-		icc_poll(sc);
-		if (!READ_ONCE(sc->icc.reply_pending)) {
-			ret = 1;
-			break;
+	/* v19: POLL fallback.  Confirmed in v18 that the southbridge sets
+	 * STATUS=0x3 + REPLY full=1 but the IRQ never fires (icc_interrupt
+	 * never gets called).  Until we resolve the MSI delivery, poll the
+	 * STATUS register every ~1ms and run the handler manually when an
+	 * event appears.  Caps at HZ * ICC_TIMEOUT total wait. */
+	{
+		/* hardcode 15s — ICC_TIMEOUT macro has a trailing ; bug (it
+		 * expands to "15;" which is invalid inside an expression). */
+		unsigned long deadline = jiffies + HZ * 15;
+		ret = 0;
+		while (time_before(jiffies, deadline)) {
+			u32 st = ioread32(sc->bar2 + BPCIE_REG_ICC_STATUS);
+			if (st & (BPCIE_ICC_SEND | BPCIE_ICC_ACK)) {
+				icc_interrupt(0, sc);
+			}
+			if (!READ_ONCE(sc->icc.reply_pending)) {
+				ret = 1;
+				break;
+			}
+			usleep_range(500, 1000);
 		}
-		if (time_after(jiffies, deadline))
-			break;
 	}
 
 	spin_lock_irq(&sc->icc.reply_lock);
