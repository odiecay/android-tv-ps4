 int ahci_ignore_sss;
 EXPORT_SYMBOL_GPL(ahci_ignore_sss);
 
+static unsigned int ps4_ahci_poll_ms;
+module_param_named(ps4_ahci_poll_ms, ps4_ahci_poll_ms, uint, 0644);
+MODULE_PARM_DESC(ps4_ahci_poll_ms,
+		 "PS4 AHCI completion poll interval in ms (0=off)");
+
 module_param_named(skip_host_reset, ahci_skip_host_reset, int, 0444);
 MODULE_PARM_DESC(skip_host_reset, "skip global host reset (0=don't skip, 1=skip)");
 
@@ -1974,6 +1980,30 @@ static void ahci_port_intr(struct ata_port *ap)
 	ahci_handle_port_interrupt(ap, port_mmio, status);
 }
 
+static void ps4_ahci_poll_timer(struct timer_list *t)
+{
+	struct ahci_port_priv *pp = timer_container_of(pp, t, ps4_poll_timer);
+	struct ata_port *ap = pp->ap;
+	unsigned long flags;
+	u32 status;
+
+	if (!ps4_ahci_poll_ms || !ap)
+		return;
+
+	if (!ata_port_is_frozen(ap)) {
+		status = readl(ahci_port_base(ap) + PORT_IRQ_STAT);
+		if (status) {
+			spin_lock_irqsave(ap->lock, flags);
+			if (!ata_port_is_frozen(ap))
+				ahci_port_intr(ap);
+			spin_unlock_irqrestore(ap->lock, flags);
+		}
+	}
+
+	mod_timer(&pp->ps4_poll_timer,
+		  jiffies + msecs_to_jiffies(ps4_ahci_poll_ms));
+}
+
 static irqreturn_t ahci_multi_irqs_intr_hard(int irq, void *dev_instance)
 {
 	struct ata_port *ap = dev_instance;
@@ -2580,6 +2610,11 @@ static int ahci_port_start(struct ata_port *ap)
 	}
 
 	ap->private_data = pp;
+	pp->ap = ap;
+	timer_setup(&pp->ps4_poll_timer, ps4_ahci_poll_timer, 0);
+	if (ps4_ahci_poll_ms)
+		mod_timer(&pp->ps4_poll_timer,
+			  jiffies + msecs_to_jiffies(ps4_ahci_poll_ms));
 
 	/* engage engines, captain */
 	return ahci_port_resume(ap);
@@ -2590,8 +2625,12 @@ static void ahci_port_stop(struct ata_port *ap)
 	const char *emsg = NULL;
 	struct ahci_host_priv *hpriv = ap->host->private_data;
 	void __iomem *host_mmio = hpriv->mmio;
+	struct ahci_port_priv *pp = ap->private_data;
 	int rc;
 
+	if (pp)
+		timer_delete_sync(&pp->ps4_poll_timer);
+
 	/* de-initialize port */
 	rc = ahci_deinit_port(ap, &emsg);
 	if (rc)
