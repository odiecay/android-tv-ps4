+	if (ucMod < (ARRAY_SIZE(g_arSwCrModHandle))) {
+
+		if (g_arSwCrModHandle[ucMod] != NULL)
+			g_arSwCrModHandle[ucMod] (prAdapter, ucRead, u2Addr, pu4Data);
+	}			/* ucMod */
+}
