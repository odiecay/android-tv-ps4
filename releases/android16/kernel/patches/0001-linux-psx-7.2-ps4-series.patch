+				   TRUE,
+				   TRUE,
+				   nicCmdEventQueryStatistics,
+				   nicOidCmdTimeoutCommon,
+				   sizeof(PARAM_802_11_STATISTICS_STRUCT_T), (PUINT_8)&rStatistics,
