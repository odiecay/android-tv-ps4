+#endif
+
+	return fgSuccess;
+}
+
diff --git a/drivers/net/wireless/mediatek/mt76x8/drv_wlan/MT6632/wlan/os/linux/hif/sdio/sdio_test_driver_core.c b/drivers/net/wireless/mediatek/mt76x8/drv_wlan/MT6632/wlan/os/linux/hif/sdio/sdio_test_driver_core.c
