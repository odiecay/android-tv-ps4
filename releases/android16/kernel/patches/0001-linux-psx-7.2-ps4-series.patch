+#if HIF_USB_DEBUG
+#define ASSERT(expr) \
+	do { \
+		if (!(expr)) { \
+			pr_err("assertion failed! %s[%d]: %s\n", \
+			       __func__, __LINE__, #expr); \
+			WARN_ON(!(expr)); \
+		} \
+	} while (0)
+#else
+#define ASSERT(expr)    do {} while (0)
+#endif
