+VOID swCrReadWriteCmd(P_ADAPTER_T prAdapter, UINT_8 ucRead, UINT_16 u2Addr, UINT_32 *pu4Data)
+{
+	UINT_8 ucMod;
+
+	ucMod = u2Addr >> 8;
+	/* Address [15:8] MOD ID */
+	/* Address [7:0] OFFSET */
+
+	DEBUGFUNC("swCrReadWriteCmd");
+	DBGLOG(SW4, INFO, "%u addr 0x%x data 0x%x\n", ucRead, u2Addr, *pu4Data);
