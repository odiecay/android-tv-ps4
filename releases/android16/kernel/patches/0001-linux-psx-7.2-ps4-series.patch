+/*----------------------------------------------------------------------------*/
+WLAN_STATUS nicTxInitResetResource(IN P_ADAPTER_T prAdapter)
+{
+	P_TX_CTRL_T prTxCtrl;
+	UINT_8 ucIdx;
+
+	DEBUGFUNC("nicTxInitResetResource");
