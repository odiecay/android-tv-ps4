+	ASSERT(pvSetBuffer);
+	prPtaIpc = (P_PTA_IPC_T) pvSetBuffer;
+
+#if CFG_SUPPORT_BCM && CFG_SUPPORT_BCM_BWCS && CFG_SUPPORT_BCM_BWCS_DEBUG
