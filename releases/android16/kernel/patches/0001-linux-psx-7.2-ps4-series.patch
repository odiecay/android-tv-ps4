+		if (!prAdapter->fgIsP2PRegistered)
+			break;
+
+		prBssInfo = prAdapter->aprBssInfo[prMsduInfo->ucBssIndex];
+
+		prP2pSpeBssInfo = prAdapter->rWifiVar.prP2pSpecificBssInfo[prBssInfo->u4PrivateData];
