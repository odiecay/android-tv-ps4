+/* fill wiphy flag */
+#define TDLSEX_WIPHY_FLAGS_INIT(__fgFlag__)							\
+{												\
+	__fgFlag__ |= (WIPHY_FLAG_SUPPORTS_TDLS | WIPHY_FLAG_TDLS_EXTERNAL_SETUP);\
+}
