+/*----------------------------------------------------------------------------*/
+VOID rsnSelectPmkidCandidateList(IN P_ADAPTER_T prAdapter, IN P_BSS_DESC_T prBssDesc)
+{
+	P_CONNECTION_SETTINGS_T prConnSettings;
