+#if MTK_WCN_HIF_SDIO
+#define HIF_SDIO_SUPPORT_GPIO_SLEEP_MODE			1
+#else
+#define HIF_SDIO_SUPPORT_GPIO_SLEEP_MODE			0
+#endif
