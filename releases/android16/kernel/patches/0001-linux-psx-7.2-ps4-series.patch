+VOID wlanTxProfilingTagMsdu(IN P_ADAPTER_T prAdapter, IN P_MSDU_INFO_T prMsduInfo, IN ENUM_TX_PROFILING_TAG_T eTag)
+{
+	wlanTxLifetimeTagPacket(prAdapter, prMsduInfo, eTag);
