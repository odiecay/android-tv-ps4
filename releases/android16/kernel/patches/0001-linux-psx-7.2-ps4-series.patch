+	AIS_REQ_CHNL_INFO rChReqInfo;
+
+	/* Mgmt tx related. */
+	AIS_MGMT_TX_REQ_INFO_T rMgmtTxInfo;
+
+	/* Packet filter for AIS module. */
+	UINT_32 u4AisPacketFilter;
+
+	/* for roaming target */
+	PARAM_SSID_T rRoamingSSID;
+} AIS_FSM_INFO_T, *P_AIS_FSM_INFO_T;
