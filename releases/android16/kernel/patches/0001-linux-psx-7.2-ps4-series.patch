+	DEBUGFUNC("wlanoidSetBT.\n");
+
+	ASSERT(prAdapter);
+	ASSERT(pu4SetInfoLen);
+
+	*pu4SetInfoLen = sizeof(PTA_IPC_T);
+	if (u4SetBufferLen != sizeof(PTA_IPC_T)) {
+		/* WARNLOG(("Invalid length %ld\n", u4SetBufferLen)); */
+		return WLAN_STATUS_INVALID_LENGTH;
