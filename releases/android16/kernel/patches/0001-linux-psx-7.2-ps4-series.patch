+/*----------------------------------------------------------------------------*/
+static int bowHardStartXmit(IN struct sk_buff *prSkb, IN struct net_device *prDev)
+{
+	P_GLUE_INFO_T prGlueInfo = *((P_GLUE_INFO_T *) netdev_priv(prDev));
+
+	P_QUE_ENTRY_T prQueueEntry = NULL;
+	P_QUE_T prTxQueue = NULL;
