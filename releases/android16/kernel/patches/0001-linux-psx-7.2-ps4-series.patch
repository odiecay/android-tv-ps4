@@ -0,0 +1,194 @@
+
+#include "gl_os.h"
+
+#if (CFG_SDIO_1BIT_DATA_MODE == 1)
+/*
+ *  linux/drivers/mmc/sdio_ops.c
+ *
+ *  Copyright 2006-2007 Pierre Ossman
+ *
