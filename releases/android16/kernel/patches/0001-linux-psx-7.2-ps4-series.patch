+VOID kalResetPacket(IN P_GLUE_INFO_T prGlueInfo, IN P_NATIVE_PACKET prPacket)
+{
+	struct sk_buff *prSkb = (struct sk_buff *)prPacket;
+
+	/* Reset cb */
+	kalMemZero(prSkb->cb, sizeof(prSkb->cb));
+}
