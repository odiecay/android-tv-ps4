+static const u8 led_pulsate_orange[] = {
+	0x03, 0x01, 0x00, 0x00, 0x10, 0x01, 0x02, 0x00,
+	0x02, 0x01, 0x00, 0x11, 0x01, 0x02, 0x00, 0x02,
+	0x01, 0x00, 0x02, 0x03, 0x01, 0xff, 0x04, 0x01,
+	0x00, 0x02, 0xff, 0x05, 0x01, 0xff, 0x02, 0xff,
+	0x05, 0x01, 0x00
+};
+
