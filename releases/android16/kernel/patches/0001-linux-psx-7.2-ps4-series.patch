+	(PUINT_8) DISP_STRING("AAA_SEND_AUTH2"),
+	(PUINT_8) DISP_STRING("AAA_SEND_AUTH4"),
+	(PUINT_8) DISP_STRING("AAA_SEND_ASSOC2"),
+	(PUINT_8) DISP_STRING("AA_RESOURCE")
+};
