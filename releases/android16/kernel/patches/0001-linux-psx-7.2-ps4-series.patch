+	if (!prAdapter)
+		ASSERT(FALSE);
+	prWtbl = prAdapter->rWifiVar.arWtbl;
+	if (ucIndex < WTBL_SIZE) {
+		if (prWtbl[ucIndex].ucUsed && prWtbl[ucIndex].ucPairwise)
+			return &prWtbl[ucIndex].aucMacAddr[0];
+	}
+	return NULL;
+}
