+	HAL_MCR_RD(_prAdapter, prChipInfo->sw_sync0, &u4Value); \
+	if ((u4Value & (_checkItem << prChipInfo->sw_ready_bit_offset)) == 0) \
+		*_pfgResult = TRUE; \
+} while (0)
