+		for (ucIdx2 = 0; ucIdx2 < ucChannelNum; ucIdx2++) {
+			if (prChnLoadInfo->rChnRankList[ucIdx].ucChannel ==
+				prChannelList[ucIdx2].ucChannelNum) {
