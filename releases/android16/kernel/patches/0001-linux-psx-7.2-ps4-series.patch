+			       "Change wapi key index from %d->%d\n",
+			       g_prWifiVar->rAisSpecificBssInfo.ucWpiActivedPWKey, ucKeyId);
+			g_prWifiVar->rAisSpecificBssInfo.ucWpiActivedPWKey = ucKeyId;
