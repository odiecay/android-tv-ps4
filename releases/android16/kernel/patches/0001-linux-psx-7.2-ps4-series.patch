+/*----------------------------------------------------------------------------*/
+VOID glBusRelease(PVOID pvData)
+{
+	/* 1. memory unmapping for MT5931 */
+	mt5931_ehpi_reg_uninit();
+
+	/* 2. uninitialize eHPI control registers */
+	collibri_ehpi_reg_uninit();
+}				/* end of glBusRelease() */
