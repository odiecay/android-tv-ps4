+VOID
+p2pRoleFsmStateTransition(IN P_ADAPTER_T prAdapter,
+			  IN P_P2P_ROLE_FSM_INFO_T prP2pRoleFsmInfo, IN ENUM_P2P_ROLE_STATE_T eNextState);
