+	memcpy(&u4Band, HqaCmdFrame->Data + 4 * 5, 4);
+	u4Band = ntohl(u4Band);
+	memcpy(&u4RunType, HqaCmdFrame->Data + 4 * 6, 4);
+	u4RunType = ntohl(u4RunType);
+	memcpy(&u4FType, HqaCmdFrame->Data + 4 * 7, 4);
