+
+#endif
+
+	wlanSendSetQueryCmd(prAdapter,
+			    CMD_ID_SET_BWCS,
+			    TRUE, FALSE, FALSE, NULL, NULL, sizeof(PTA_IPC_T), (PUINT_8) prPtaIpc, NULL, 0);
