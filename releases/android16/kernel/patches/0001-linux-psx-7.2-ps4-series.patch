+INT_32 mtk_Netdev_To_RoleIdx(P_GLUE_INFO_T prGlueInfo, struct net_device *ndev, PUINT_8 pucRoleIdx)
+{
+	INT_32 i4Ret = -1;
+	UINT_32 u4Idx = 0;
+
+	if (pucRoleIdx == NULL)
+		return i4Ret;
