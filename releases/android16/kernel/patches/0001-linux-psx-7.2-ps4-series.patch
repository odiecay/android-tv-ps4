+BOOLEAN glWakeupSdio(P_GLUE_INFO_T prGlueInfo)
+{
+	BOOLEAN fgSuccess = TRUE;
+
+#if (HIF_SDIO_SUPPORT_GPIO_SLEEP_MODE && MTK_WCN_HIF_SDIO)
+	if (mtk_wcn_hif_sdio_wake_up_ctrl(prGlueInfo->rHifInfo.cltCtx) != 0)
