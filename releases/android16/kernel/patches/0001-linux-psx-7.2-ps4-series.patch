+	prHif = &prGlueInfo->rHifInfo;
+
+	/* fill some buffered information into prHif */
+	prHif->mcr_addr_base = mt5931_mcr_base + EHPI_OFFSET_ADDR;
+	prHif->mcr_data_base = mt5931_mcr_base + EHPI_OFFSET_DATA;
+}				/* end of glSetHifInfo() */
