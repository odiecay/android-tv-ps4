+	for ((_u2Offset) = 0; ((_u2Offset) < (_u2AttriBufLen)); \
+	     (_u2Offset) += WSC_ATTRI_SIZE(_pucAttriBuf), ((_pucAttriBuf) += WSC_ATTRI_SIZE(_pucAttriBuf)))
