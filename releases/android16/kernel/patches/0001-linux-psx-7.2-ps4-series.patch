+/*! \file   typedef.h
+*    \brief  Declaration of data type and return values of internal protocol stack.
+*
+*    In this file we declare the data type and return values which will be exported
+*    to the GLUE Layer.
+*/
+
+#ifndef _TYPEDEF_H
+#define _TYPEDEF_H
+
