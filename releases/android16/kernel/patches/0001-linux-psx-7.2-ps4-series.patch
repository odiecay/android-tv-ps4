+	MT_ATESetDBDCBandIndex(prNetDev, u4Band_idx);
+
+	rRfATInfo.u4FuncIndex = RF_AT_FUNCID_SET_RECAL_CAL_STEP;
+	rRfATInfo.u4FuncData = u4Item;
+
