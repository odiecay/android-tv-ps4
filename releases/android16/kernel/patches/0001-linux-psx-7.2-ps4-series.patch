+{
+	UINT_32 u4DataMode = 0;
+	fw_image_tailer_t *prFwHead;
+	tailer_format_t *prTailer;
+
+	prFwHead = (fw_image_tailer_t *) (pvFwImageMapFile + u4FwImageFileLength - sizeof(fw_image_tailer_t));
