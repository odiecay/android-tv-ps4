+static INT_8 atoi(UCHAR ch)
+{
+	if (ch >= 'a' && ch <= 'f')
+		return ch - 87;
+	else if (ch >= 'A' && ch <= 'F')
+		return ch - 55;
+	else if (ch >= '0' && ch <= '9')
+		return ch - 48;
+
+	return 0;
+}
