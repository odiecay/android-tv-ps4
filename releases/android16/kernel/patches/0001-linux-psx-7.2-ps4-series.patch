+		break;
+
+	case NETWORK_TYPE_BOW:
+	case NETWORK_TYPE_P2P:
+	default:
+		break;
+	}
+
+	return WLAN_STATUS_SUCCESS;
+}				/* end of nicMediaJoinFailure() */
