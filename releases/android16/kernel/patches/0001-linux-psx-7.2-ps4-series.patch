+VOID bssDumpBssInfo(IN P_ADAPTER_T prAdapter, IN UINT_8 ucBssIndex)
+{
+	P_BSS_INFO_T prBssInfo;
+	/* P_LINK_T prStaRecOfClientList = (P_LINK_T) NULL; */
+	/* P_STA_RECORD_T prCurrStaRec = (P_STA_RECORD_T) NULL; */
