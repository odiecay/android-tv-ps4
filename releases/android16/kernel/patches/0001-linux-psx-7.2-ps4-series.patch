+/* 20150205 work queue for sched_scan */
+	INIT_DELAYED_WORK(&sched_workq, wlanSchedScanStoppedWorkQueue);
+
+/* 20161024 init wow port setting */
+#if CFG_WOW_SUPPORT
+	kalWowInit(prGlueInfo);
+#endif
+
+	return 0;		/* success */
+}				/* end of wlanInit() */
