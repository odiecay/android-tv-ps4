+void glGetDev(PVOID ctx, struct device **dev)
+{
+	*dev = &((struct pci_dev *)ctx)->dev;
+}
+
+void glGetHifDev(P_GL_HIF_INFO_T prHif, struct device **dev)
+{
+	*dev = &(prHif->pdev->dev);
+}
