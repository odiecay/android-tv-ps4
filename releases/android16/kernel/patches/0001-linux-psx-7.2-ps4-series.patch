+/*----------------------------------------------------------------------------*/
+VOID rlmFillVhtOpIE(P_ADAPTER_T prAdapter, P_BSS_INFO_T prBssInfo, P_MSDU_INFO_T prMsduInfo)
+{
+	P_IE_VHT_OP_T prVhtOp;
+
+	ASSERT(prAdapter);
