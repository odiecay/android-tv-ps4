+/*----------------------------------------------------------------------------*/
+/*!
+* \brief get config from wifi.cfg
+*
+* \param[in] prAdapter
+*
+* \retval VOID
+*/
+/*----------------------------------------------------------------------------*/
+VOID wlanGetConfig(P_ADAPTER_T prAdapter)
+{
+	PUINT_8 pucConfigBuf;
+	UINT_32 u4ConfigReadLen;
+
+	wlanCfgInit(prAdapter, NULL, 0, 0);
