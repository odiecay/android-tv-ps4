+/*! \file   "cnm_mem.h"
+*    \brief  In this file we define the structure of the control unit of
+*	    packet buffer and MGT/MSG Memory Buffer.
+*/
+
+
+#ifndef _CNM_MEM_H
+#define _CNM_MEM_H
+
+/*******************************************************************************
+*                         C O M P I L E R   F L A G S
+********************************************************************************
+*/
