+*                       mapped base address.
+*
+* \return (none)
+*/
+/*----------------------------------------------------------------------------*/
+BOOL glBusInit(PVOID pvData)
+{
+#if DBG
+	initTrig();
+#endif
+
+	/* 1. initialize eHPI control registers */
+	collibri_ehpi_reg_init();
+
+	/* 2. memory remapping for MT5931 */
+	mt5931_ehpi_reg_init();
+
+	return TRUE;
+};
