+		nicTxSetPktFixedRateOption(prMsduInfo, u2RateCode, FIX_BW_NO_FIXED, FALSE, FALSE);
+#else
+		nicTxSetPktLowestFixedRate(prAdapter, prMsduInfo);
+#endif
