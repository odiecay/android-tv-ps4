+/*----------------------------------------------------------------------------*/
+static INT_32 hqa_start_rx_ext(struct net_device *prNetDev,
+			       IN union iwreq_data *prIwReqData, HQA_CMD_FRAME *HqaCmdFrame)
+{
+	INT_32 i4Ret = 0;
+	UINT_32 u4Ext_id = 0;
+	UINT_32 u4Param_num = 0;
