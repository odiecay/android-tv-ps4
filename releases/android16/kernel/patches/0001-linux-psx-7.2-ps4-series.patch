+	if ((prBssDesc->u2BSSBasicRateSet &
+	     ~(rPhyAttributes[prAisBssInfo->ePhyType].u2SupportedRateSet)) || prBssDesc->fgIsUnknownBssBasicRate) {
+		DBGLOG(RSN, TRACE, "-- Rate set not matched\n");
