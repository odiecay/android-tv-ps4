From 53b65dced3ca40923651f3b6c413e818eb81b97f Mon Sep 17 00:00:00 2001
From: Codey <codey@eliterepairs.com.au>
Date: Tue, 27 Oct 2026 16:42:38 +1000
Subject: [PATCH 09/31] DEBUG (dev, revert later): sky2 interrupt status
 statistics

---
 drivers/net/ethernet/marvell/sky2.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/net/ethernet/marvell/sky2.c b/drivers/net/ethernet/marvell/sky2.c
index 8251c9d64..270829044 100644
--- a/drivers/net/ethernet/marvell/sky2.c
+++ b/drivers/net/ethernet/marvell/sky2.c
@@ -3068,6 +3068,18 @@ static irqreturn_t sky2_intr(int irq, void *dev_id)
 	sky2_write32(hw, AEOLIA_SP_ICR, 2);
 #endif
 	status = sky2_read32(hw, B0_Y2_SP_ISRC2);
+#ifdef CONFIG_X86_PS4
+	{	/* DEBUG (dev, revert later): which status bits drive the IRQ rate */
+		static unsigned long n, none;
+		static u32 seen;
+		n++; seen |= status;
+		if (status == 0 || status == ~0)
+			none++;
+		if (!(n % 20000))
+			pr_info("atvdbg: sky2 irq %lu, empty %lu, status now %08x, bits seen %08x, lisr %08x\n",
+				n, none, status, seen, sky2_read32(hw, B0_Y2_SP_LISR));
+	}
+#endif
 	if (status == 0 || status == ~0) {
 		sky2_write32(hw, B0_Y2_SP_ICR, 2);
 		return IRQ_NONE;
