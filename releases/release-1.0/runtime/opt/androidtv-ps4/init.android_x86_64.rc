# Android TV for PS4 16 internal dev: network ADB on 5555 (each host is
# still authorised on the TV), started before setup so a dev can watch boot.
on post-fs-data
    setprop service.adb.tcp.port 5555
    start adbd

on property:sys.boot_completed=1
    setprop service.adb.tcp.port 5555
    start adbd
