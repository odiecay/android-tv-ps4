#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
exec </dev/console >/dev/console 2>&1
hostname androidtv-ps4
build=$(sed -n 's/.*androidtv.boot_id=\([^ ]*\).*/\1/p' /proc/cmdline)
echo "Android TV for PS4 ${build:-unknown build}: standalone installer"
echo 'Android storage will be prepared on the internal drive.'
echo 7 > /proc/sys/kernel/printk
mdev -s
quota_module=/lib/modules/$(uname -r)/extra/xt_quota2.ko
if [ -f "$quota_module" ]; then
    insmod "$quota_module" || echo 'Android quota2 module failed to load'
fi
ip link set lo up
mkdir -p /run/androidtv-ps4
# The build goes first in the logs people send, so an old build is obvious.
echo "Android TV for PS4 ${build:-unknown build}" > /run/androidtv-ps4/progress.log
uname -a > /run/androidtv-ps4/uname.txt
cat /proc/cmdline > /run/androidtv-ps4/cmdline.txt
cat /proc/meminfo > /run/androidtv-ps4/meminfo.txt
cat /proc/partitions > /run/androidtv-ps4/partitions.txt
ip addr > /run/androidtv-ps4/network.txt
dmesg > /run/androidtv-ps4/dmesg.txt
for d in /sys/bus/pci/devices/*; do
    echo "$d $(cat "$d/vendor") $(cat "$d/device") $(cat "$d/class")"
done > /run/androidtv-ps4/pci.txt
echo 'Logs are in /run/androidtv-ps4. Reboot returns to the PS4 operating system.'
# Until Android is running, copy this start's logs to any USB stick every few
# seconds, so a start with no picture still shows where it stopped. They go in
# AndroidTV-PS4-logs, the same folder and file names as the console's own
# logs folder, with the start before in previous/. The PS4's own drive is the
# disk with partition 27 and is never touched. A stick with no
# AndroidTV-PS4-logs folder at all means Linux never got this far.
usb_startup_logs() {
    round=0
    while [ ! -f /run/androidtv-ps4/android-launched ] && [ "$round" -lt 120 ]; do
        round=$((round + 1))
        for block in /sys/class/block/sd*; do
            [ -e "$block" ] || continue
            name=${block##*/}; disk=${name%%[0-9]*}
            [ -b "/dev/${disk}27" ] && continue
            mkdir -p /mnt/usb-logs
            mount -t vfat "/dev/$name" /mnt/usb-logs 2>/dev/null || mount -t exfat "/dev/$name" /mnt/usb-logs 2>/dev/null || continue
            out=/mnt/usb-logs/AndroidTV-PS4-logs
            if [ "$round" = 1 ] && [ -d "$out" ]; then
                rm -rf "$out.last"; mv "$out" "$out.last"
                mkdir -p "$out"; rm -rf "$out.last/previous"; mv "$out.last" "$out/previous"
            fi
            if mkdir -p "$out"; then
                {
                    echo "Android TV for PS4 ${build:-unknown build}"
                    echo "Copied $round times, last at $(cut -d' ' -f1 /proc/uptime) s after Linux started"
                    echo "Kernel: $(cat /proc/version)"
                    for d in /sys/bus/pci/devices/*; do
                        [ "$(cat "$d/vendor")" = 0x104d ] && echo "Southbridge PCI: ${d##*/} $(cat "$d/device") driver=$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)"
                        [ "$(cat "$d/vendor")" = 0x1002 ] && echo "AMD PCI: ${d##*/} $(cat "$d/device") driver=$(basename "$(readlink "$d/driver" 2>/dev/null)" 2>/dev/null)"
                    done
                    for c in /sys/class/drm/card*-*; do [ -e "$c/status" ] && echo "Display output ${c##*/}: $(cat "$c/status")"; done
                    [ -e /dev/fb0 ] && echo "Framebuffer: yes" || echo "Framebuffer: none yet"
                    echo; echo "Southbridge and display lines from the kernel log:"
                    dmesg | grep -iE 'bpcie|apcie|baikal|icc|ps4.bridge|amdgpu|drm|fb0|probe.*defer' | tail -80
                } > "$out/status.txt" 2>&1
                dmesg > "$out/kernel.log" 2>&1
                cp /run/androidtv-ps4/*.log /run/androidtv-ps4/*.txt "$out/" 2>/dev/null
                sync
            fi
            umount /mnt/usb-logs 2>/dev/null
        done
        # Dev build: every second for the first 30 s, so an early hang still
        # leaves its last lines on the stick.
        if [ "$round" -lt 30 ]; then sleep 1; else sleep 5; fi
    done
}
usb_startup_logs &
if [ -x /usr/sbin/androidtv-ps4-start ]; then
    echo '[Android TV] Linux payload running; Android will start automatically.'
    (/usr/sbin/androidtv-ps4-start 2>&1 | tee /run/androidtv-ps4/setup.log) &
    while :; do sleep 3600; done
fi
while :; do
    echo "Android startup unavailable. Restart the console to return to PS4."
    sleep 1
done
